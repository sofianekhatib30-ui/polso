# Copia questo file in .env e scegli valori tuoi. Il file .env non va mai su GitHub.

# password del database locale (solo Docker)
POSTGRES_PASSWORD=

# token che il checker usa per scrivere sull'API: una stringa lunga e casuale,
# per esempio generata con:  openssl rand -hex 32
POLSO_INGEST_TOKEN=

# avvisi (facoltativi): lascia vuoto per non riceverli
# Slack: indirizzo di un Incoming Webhook (https://hooks.slack.com/services/...)
SLACK_WEBHOOK_URL=
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
